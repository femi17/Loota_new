NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Only for `npm run db:push` (applies database migrations). Never commit.
# Access token: Supabase > Account (avatar, top right) > Access Tokens > Generate new token
SUPABASE_ACCESS_TOKEN=sbp_...
# Database password: the one chosen when creating the project
# (reset it under Project Settings > Database if you don't have it)
SUPABASE_DB_PASSWORD=

# Paystack (buying coins). The public key goes to the browser; the secret key stays on the server.
# Dashboard > Settings > API Keys & Webhooks (use the test keys until going live).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
